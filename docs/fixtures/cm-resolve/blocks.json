{
  "_doc": "Spec 2026-11-03 §5.5 -- Block-Regel (nur Deno, resolve-cm-product/blocks.ts). versionGroups = je Expansion aus exp die IDs der Karte; printingRarities/rk als RarityNorm.key. Erwartet idProduct (null = keine Aussage) und reason.",
  "cases": [
    { "name": "eindeutige Ordnung, mittlere Seltenheit",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600, "secretrare": 700 } },
      "versionGroups": { "20": [612, 511, 705] }, "printingRarities": ["secretrare", "superrare", "ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": 612, "reason": "blocks" } },
    { "name": "eindeutige Ordnung, Mediane nicht in Seltenheitsreihenfolge",
      "blocks": { "20": { "superrare": 900, "ultrarare": 100 } },
      "versionGroups": { "20": [150, 950] }, "printingRarities": ["superrare", "ultrarare"], "rk": "superrare",
      "expect": { "idProduct": 950, "reason": "blocks" } },
    { "name": "fehlender Median",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600 } },
      "versionGroups": { "20": [511, 612, 705] }, "printingRarities": ["superrare", "ultrarare", "secretrare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "no-median" } },
    { "name": "Expansion ohne Block-Daten",
      "blocks": { "21": { "superrare": 500, "ultrarare": 600 } },
      "versionGroups": { "20": [511, 612] }, "printingRarities": ["superrare", "ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "no-median" } },
    { "name": "gleiche Mediane",
      "blocks": { "20": { "superrare": 500, "ultrarare": 500 } },
      "versionGroups": { "20": [511, 612] }, "printingRarities": ["superrare", "ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "equal-medians" } },
    { "name": "n ungleich Anzahl Seltenheiten",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600, "secretrare": 700 } },
      "versionGroups": { "20": [511, 612] }, "printingRarities": ["superrare", "ultrarare", "secretrare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "count-mismatch" } },
    { "name": "doppelte Seltenheit (Deck-Set)",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600 } },
      "versionGroups": { "20": [511, 612] }, "printingRarities": ["ultrarare", "ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "duplicate-rarity" } },
    { "name": "zwei Expansionen mit Versionen",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600 }, "21": { "superrare": 800, "ultrarare": 900 } },
      "versionGroups": { "20": [511, 612], "21": [811] }, "printingRarities": ["superrare", "ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "no-group" } },
    { "name": "nur eine Version",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600 } },
      "versionGroups": { "20": [511] }, "printingRarities": ["ultrarare"], "rk": "ultrarare",
      "expect": { "idProduct": null, "reason": "no-group" } },
    { "name": "gesuchte Seltenheit nicht in printingRarities",
      "blocks": { "20": { "superrare": 500, "ultrarare": 600, "secretrare": 700 } },
      "versionGroups": { "20": [511, 612] }, "printingRarities": ["superrare", "ultrarare"], "rk": "secretrare",
      "expect": { "idProduct": null, "reason": "rarity-not-listed" } }
  ]
}
